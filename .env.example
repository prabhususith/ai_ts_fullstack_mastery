# ==============================================================================
# Enterprise Full-Stack AI Ecosystem - Environment Configuration
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL with pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_enterprise_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_enterprise_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL_ENABLED=false

# Redis Configuration (ioredis)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# Security & Cryptography
JWT_SECRET=super-secret-jwt-key-with-minimum-32-characters-entropy-999
JWT_EXPIRATION=24h
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
CANARY_TOKEN_SECRET=canary-guard-entropy-777
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Cloud Deployment Profile (localhost | aws | azure | gcp)
CLOUD_PROVIDER=localhost
AWS_REGION=us-east-1
AZURE_LOCATION=eastus
GCP_REGION=us-central1

# Edge / Embeddings Engine Configuration
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDINGS_DIMENSION=384
MAX_CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# External Model Providers (Optional API Keys - local inference runs 100% in pure TS/WASM without keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LANGSMITH_API_KEY=
