# ==============================================================================
# Development Container Dockerfile (Frontend - Vite HMR Dev Server)
# ==============================================================================
FROM node:20-alpine

WORKDIR /usr/src/app

# Copy dependency manifests
COPY frontend/package*.json frontend/tsconfig*.json frontend/vite.config.ts frontend/tailwind.config.js frontend/postcss.config.js frontend/index.html ./

# Install dependencies
RUN npm install

# Expose Vite HMR default port
EXPOSE 5173

ENV NODE_ENV=development

# Run Vite dev server with host binding for Docker port mapping
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
