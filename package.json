{
  "name": "ai-ts-fullstack-mastery",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Full-Stack TypeScript AI Ecosystem with pgvector, Redis Semantic Cache, MCP, and ReAct Agents",
  "author": "Google Antigravity Architect",
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "dev:all": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=backend",
    "test:coverage": "npm run test:coverage --workspace=backend",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "generate:ebook": "node docs/ebook/generate_ebook.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
