# ==============================================================================
# Enterprise Multi-Stage Dockerfile (Frontend - React 18+ Vite TypeScript)
# Target: Nginx Alpine hardened static web server with SPA routing fallback
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Bundle Compilation
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

# Copy dependency manifests
COPY frontend/package*.json frontend/tsconfig*.json frontend/vite.config.ts frontend/tailwind.config.js frontend/postcss.config.js frontend/index.html ./

# Install dependencies
RUN npm install

# Copy source code
COPY frontend/src/ ./src/

# Compile production Vite bundle
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Production Nginx Static Server
# ------------------------------------------------------------------------------
FROM nginx:1.25-alpine AS runner

# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from builder stage
COPY --from=builder /usr/src/app/dist /usr/share/nginx/html

# Copy custom Nginx SPA routing and reverse-proxy configuration
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Security: Ensure non-root ownership permissions on cache and run directories
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /usr/share/nginx/html /etc/nginx/conf.d

# Expose ports for standard HTTP traffic
EXPOSE 80 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q --spider http://localhost:80/healthz || exit 1

# Launch Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
